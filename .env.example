# Copy this file to .env and fill in your actual values.
# Docker Compose reads .env automatically from the project root.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Ollama URL
# Dev mode (docker-compose.dev.yml): leave unset — the compose override hardcodes http://ollama:11434
# Prod mode: set this to your external Ollama instance
OLLAMA_URL=http://localhost:11434

# Optional: basic auth for Ollama behind a reverse proxy
# Leave blank for local/dev setups that do not require auth
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

# Optional: override the Gemini model (default: gemini-3.1-flash-lite-preview)
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
